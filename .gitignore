# ── 저장소 수위: 15세 이용가 기준 ──
# 사용자가 수위를 올린 그림·문구를 넣는 자리는 Git에 올리지 않는다(로컬에만 둔다).
# 그림이 없으면 게임은 기존 그림으로 대체하므로 이 파일들이 없어도 빌드·검사는 된다.
# 사망 HUD 일러스트
/Assets/SaintKnightDay15/Resources/SaintKnightDay15/DefeatPortraits/*.png
/Assets/SaintKnightDay15/Resources/SaintKnightDay15/DefeatPortraits/*.png.meta
# 사망 컷씬
/Assets/SaintKnightDay15/Resources/SaintKnightDay15/DeathCutscenes/
/Assets/SaintKnightDay15/Resources/SaintKnightDay15/DeathCutscenes.meta
# 움직이는 사망 장면(같은 이름으로 수위를 올린 판이 덮어쓰임)
/Assets/SaintKnightSpriteCook/Resources/SaintKnightSpriteCook/*_death_*.png
/Assets/SaintKnightSpriteCook/Resources/SaintKnightSpriteCook/*_death_*.png.meta
# 측면 HUD 손상 단계 일러스트(노출이 있음) — .meta는 GUID 기록용으로 남긴다
/Assets/SaintKnightDay06/Art/Portraits/*.png
/Docs/Design/Characters/reference/
/Docs/Design/Characters/portraits_preview.png
# 28일차 갤러리용 3D 일러스트 원본
/Docs/Design/Gallery/Source/
